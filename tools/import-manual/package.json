{
  "name": "@blood-bowl-tracker/import-manual",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "bin": {
    "import-manual": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --check \"{src,test}/**/*.ts\"",
    "format:fix": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run --coverage && vitest run --config vitest.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "zod": "^4.4.3",
    "@blood-bowl-tracker/api-client": "workspace:*",
    "@blood-bowl-tracker/api-contract": "workspace:*",
    "@blood-bowl-tracker/import": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@blood-bowl-tracker/api-server": "workspace:*",
    "@blood-bowl-tracker/db": "workspace:*",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
  }
}
