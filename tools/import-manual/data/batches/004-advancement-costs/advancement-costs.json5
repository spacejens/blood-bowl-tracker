// Batch 004: the SPP cost of each advancement under the rules sets that use
// fixed thresholds -- CRP, CRP+ and BB2016.
//
// All three share the cumulative thresholds 6, 16, 31, 51, 76 and 176 SPP;
// reaching each one earns a roll on the rules set's advancement table
// (`table_roll`). A row stores the cost of one advancement -- the gap to the
// previous threshold -- not the threshold itself, so the costs of a player's
// first N advancements sum to the Nth threshold:
//
//   advancement   1    2    3    4    5    6
//   threshold     6   16   31   51   76  176
//   cost          6   10   15   20   25  100
//
// tLoEG house rule: a tLoEG player who reaches 301 total SPP gains the Fan
// Favourite skill as a seventh advancement, after the rules set's six, with
// no roll (`granted_skill`). It held while tLoEG played under CRP, CRP+ and
// BB2016, and does not apply under BB2020, DB2021 or BB2025, so it is
// curated only for those three rules sets. Its cost is the gap from the
// sixth threshold: 176 + 125 = 301. These rows add to the rules set's rows
// for tLoEG's players; they do not replace them. The source is the
// developer's statement of the league's rule.
//
// The rules sets, the tLoEG league and the Fan Favourite skill already exist
// (batch 001 declares them). The rules sets and the skill are referenced
// under the "Name" system by bare name, the league under its BBL system
// `tloeg.bbleague.se`. curated-data-batch-004.spec.ts checks the costs
// against the thresholds and the tLoEG total of 301.
{
  externalSystems: [
    { name: 'Name', category: 'bookkeeping' },
    { name: 'tloeg.bbleague.se', category: 'imported_data_source' },
  ],

  advancementCosts: [
    // --- CRP ---
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 1, advancementKind: 'table_roll', sppCost: 6 },
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 2, advancementKind: 'table_roll', sppCost: 10 },
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 3, advancementKind: 'table_roll', sppCost: 15 },
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 4, advancementKind: 'table_roll', sppCost: 20 },
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 5, advancementKind: 'table_roll', sppCost: 25 },
    { rulesSet: { system: 'Name', id: 'CRP' }, advancementNumber: 6, advancementKind: 'table_roll', sppCost: 100 },

    // --- CRP+ (identical to CRP) ---
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 1, advancementKind: 'table_roll', sppCost: 6 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 2, advancementKind: 'table_roll', sppCost: 10 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 3, advancementKind: 'table_roll', sppCost: 15 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 4, advancementKind: 'table_roll', sppCost: 20 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 5, advancementKind: 'table_roll', sppCost: 25 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, advancementNumber: 6, advancementKind: 'table_roll', sppCost: 100 },

    // --- BB2016 (identical to CRP) ---
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 1, advancementKind: 'table_roll', sppCost: 6 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 2, advancementKind: 'table_roll', sppCost: 10 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 3, advancementKind: 'table_roll', sppCost: 15 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 4, advancementKind: 'table_roll', sppCost: 20 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 5, advancementKind: 'table_roll', sppCost: 25 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, advancementNumber: 6, advancementKind: 'table_roll', sppCost: 100 },

    // --- tLoEG house rule: Fan Favourite at 301 SPP (176 + 125) ---
    { rulesSet: { system: 'Name', id: 'CRP' }, league: { system: 'tloeg.bbleague.se', id: 'tLoEG' }, advancementNumber: 7, advancementKind: 'granted_skill', skill: { system: 'Name', id: 'Fan Favourite' }, sppCost: 125 },
    { rulesSet: { system: 'Name', id: 'CRP+' }, league: { system: 'tloeg.bbleague.se', id: 'tLoEG' }, advancementNumber: 7, advancementKind: 'granted_skill', skill: { system: 'Name', id: 'Fan Favourite' }, sppCost: 125 },
    { rulesSet: { system: 'Name', id: 'BB2016' }, league: { system: 'tloeg.bbleague.se', id: 'tLoEG' }, advancementNumber: 7, advancementKind: 'granted_skill', skill: { system: 'Name', id: 'Fan Favourite' }, sppCost: 125 },
  ],
}
