// The era catalog: every era's name, league, dates and rules sets.
//
// Each era is keyed by its plain name under the synthetic "Name" system. The
// BBL and TP importer configs hold only era names and source-specific
// mapping, and find each era by that `Name` id. The order of an era's rules
// sets matters: where one rules set has to be chosen for an era, the
// last-listed one is preferred.
{
  externalSystems: [
    { name: 'tloeg.bbleague.se', category: 'imported_data_source' },
    { name: 'Name', category: 'bookkeeping' },
  ],
  eras: [
    // -- BBL eras (tools/import-bbl/import-bbl-config.json5).
    {
      name: 'First era',
      league: { system: 'tloeg.bbleague.se', id: 'tLoEG' },
      startDate: '2011-09-09',
      endDate: '2021-09-01',
      rulesSets: [
        { system: 'Name', id: 'CRP' },
        { system: 'Name', id: 'CRP+' },
        { system: 'Name', id: 'BB2016' },
      ],
      externalIds: [{ system: 'Name', id: 'First era' }],
    },
    {
      name: 'Second era',
      league: { system: 'tloeg.bbleague.se', id: 'tLoEG' },
      startDate: '2021-09-01',
      endDate: '2023-06-15',
      rulesSets: [{ system: 'Name', id: 'BB2020' }],
      externalIds: [{ system: 'Name', id: 'Second era' }],
    },
    {
      name: 'First Stunty Leeg era',
      league: { system: 'tloeg.bbleague.se', id: 'tLoEG' },
      startDate: '2016-03-12',
      endDate: '2016-11-26',
      rulesSets: [
        { system: 'Name', id: 'CRP' },
        { system: 'Name', id: 'CRP+' },
        { system: 'Name', id: 'BB2016' },
      ],
      externalIds: [{ system: 'Name', id: 'First Stunty Leeg era' }],
    },
    {
      name: 'First Dungeon Bowl era',
      league: { system: 'tloeg.bbleague.se', id: 'tLoEG' },
      startDate: '2022-02-12',
      endDate: '2022-08-23',
      rulesSets: [{ system: 'Name', id: 'DB2021' }],
      externalIds: [{ system: 'Name', id: 'First Dungeon Bowl era' }],
    },
    {
      name: 'GBBL 1',
      league: { system: 'tloeg.bbleague.se', id: 'GBBL' },
