// The league catalog: the two real leagues.
//
// Each league is keyed by its plain name under the synthetic "Name" system.
// The BBL and TP importers find a league by that id and attach only their own
// source id to it, so tLoEG is the one league that both BBL's tLoEG data and
// the TP data import into.
{
  externalSystems: [
    { name: 'tloeg.bbleague.se', category: 'imported_data_source' },
    { name: 'Name', category: 'bookkeeping' },
  ],
  leagues: [
    {
      name: 'tLoEG',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'tLoEG' },
        { system: 'Name', id: 'tLoEG' },
      ],
    },
    {
      name: 'GBBL',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'GBBL' },
        { system: 'Name', id: 'GBBL' },
      ],
    },
  ],
}
