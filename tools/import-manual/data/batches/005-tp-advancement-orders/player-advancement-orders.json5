// Batch 005: the advancement order of five TP players, read from the TP
// notification feed.
//
// Each order comes from the feed's "New skill/characteristic" notifications
// for the player, read oldest first (two on the same day by message id). The
// first four players here are those whose notifications cover every paid
// advancement the database records and whose BB2020 prices, as the feed
// shows them, add up to the SPP the player reported as spent. The only open
// question for them was where the characteristic increases fall among the
// skills, which the notifications settle. The fifth, Nadiddnur, has two paid
// skills and a gained Loner that is a free extra and is not listed. The feed
// shows only his second skill, at the price of a second advancement, which
// places the other first, as the ascending order of TP's skill row ids does
// too.
//
// Each entry names the player by his TP line-up id. ENTRY SHAPE: as in
// docs/import-manual/player-advancement-orders.md. `advancements` lists every
// paid advancement, first taken first, each a skill under the "Name" system
// by its curated display name, or a characteristic increase (MA, ST, AG, PA
// or AV). The manual import's SPP check still applies when the batch is
// applied, and refuses any order the reported spend does not allow.
//
// curated-data-batch-005.spec.ts pins every entry.
{
  externalSystems: [
    { name: 'Name', category: 'bookkeeping' },
    { name: 'tourplay.net', category: 'imported_data_source' },
  ],
  playerAdvancementOrders: [
    // Kalle Kvist, Dalsland Treehuggers: notifications 2023-09-21 to
    // 2024-04-10; spent 110.
    {
      player: { system: 'tourplay.net', id: '586220' },
      advancements: [
        { characteristic: 'MA' },
        { skill: { system: 'Name', id: 'Side Step' } },
        { skill: { system: 'Name', id: 'Catch' } },
        { skill: { system: 'Name', id: 'Safe Pair of Hands' } },
        { skill: { system: 'Name', id: 'Sprint' } },
        { characteristic: 'AV' },
      ],
    },
    // Friska Fläkten, Gnaget: notifications 2024-08-09 to 2025-05-26;
    // spent 104.
    {
      player: { system: 'tourplay.net', id: '1233619' },
      advancements: [
        { skill: { system: 'Name', id: 'Block' } },
        { characteristic: 'AV' },
        { skill: { system: 'Name', id: 'Monstrous Mouth' } },
        { skill: { system: 'Name', id: 'Sprint' } },
        { skill: { system: 'Name', id: 'Sure Feet' } },
        { skill: { system: 'Name', id: 'Side Step' } },
      ],
    },
    // K'Lent, Mega Molochs: notifications 2023-09-20 to 2025-12-13; spent 64.
    {
      player: { system: 'tourplay.net', id: '587380' },
      advancements: [
        { characteristic: 'PA' },
        { characteristic: 'MA' },
        { skill: { system: 'Name', id: 'Block' } },
        { skill: { system: 'Name', id: 'Catch' } },
      ],
    },
    // Gruamax, Marstens IF Mrglgrlgrlgrl: notifications 2024-10-10 to
    // 2024-12-03; spent 32.
    {
      player: { system: 'tourplay.net', id: '1346393' },
      advancements: [
        { skill: { system: 'Name', id: 'Dodge' } },
        { characteristic: 'ST' },
        { skill: { system: 'Name', id: 'Pro' } },
      ],
    },
    // Nadiddnur, Shambletown Peddlers: feed notification 2025-04-16, Sneaky
    // Git at 8; spent 14. Dirty Player is not in the feed: its place follows
    // from the 8 SPP Sneaky Git cost (a second chosen primary skill; a first
    // costs 6) and from TP's skill row ids (Dirty Player 815542, Sneaky Git
    // 1122553). Dirty Player, a random secondary skill, cost 6 as the first.
    {
      player: { system: 'tourplay.net', id: '1421046' },
      advancements: [
        { skill: { system: 'Name', id: 'Dirty Player' }, attributeValue: '+1' },
        { skill: { system: 'Name', id: 'Sneaky Git' } },
      ],
    },
  ],
}
