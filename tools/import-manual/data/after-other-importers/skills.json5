// Re-asserts the canonical spelling of every merged skill-name cluster
// (before-other-importers/skills.json5 registers the same skills, with the
// same externalIds, under the same canonical names).
//
// This file exists purely to win a name race. `SkillsService.upsert` writes
// whatever `name` it is given onto the row an external id matches -- it does
// not treat a pre-registered row's name as fixed. BBL and TP each re-upsert
// these skills on every run using their OWN raw spelling (e.g. TP spells one
// "Kick Team-mate" where BBL spells it "Kick Team-Mate"), and since BBL then
// TP run after before-other-importers, whichever of them last touches a given
// skill would otherwise leave that spelling as the stored name -- not
// necessarily the canonical one chosen when the cluster was merged. Curating
// the same canonical name again here, in after-other-importers (which always
// runs last), makes the canonical spelling win regardless of import order.
//
// Only clusters that actually have more than one registered spelling need an
// entry here -- a skill with a single external id has no other spelling that
// could race it.
{
  externalSystems: [
    { name: 'Name', category: 'bookkeeping' },
    { name: 'tourplay.net', category: 'imported_data_source' },
  ],
  skills: [
    { name: 'Blood Lust', externalIds: [{ system: 'Name', id: 'Blood Lust' }, { system: 'Name', id: 'Bloodlust' }] },
    { name: 'Side Step', externalIds: [{ system: 'Name', id: 'Side Step' }, { system: 'Name', id: 'Sidestep' }] },
    { name: 'Dump-Off', externalIds: [{ system: 'Name', id: 'Dump-Off' }, { system: 'Name', id: 'Dump-off' }, { system: 'Name', id: 'Dump Off' }] },
