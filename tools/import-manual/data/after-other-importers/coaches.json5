        { system: 'tloeg.bbleague.se', id: 'Filip L' },
        { system: 'tourplay.net', id: 'acc3d88b-349a-43ed-6e7b-08da16d8d912' },
        { system: 'NAF', id: '21319' },
      ],
    },
    {
      // TP's username for this coach is "JackG", and BBL's own name for them
      // is just "Jack" with no last initial -- this entry supplies the
      // pseudonym shape directly.
      name: 'Jack G',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Jack' },
        { system: 'tourplay.net', id: '997ff288-05ca-45f4-7cc1-08dad1ed32ac' },
        { system: 'NAF', id: '21760' },
      ],
    },
    {
      // TP's username for this coach is "inforthepain", which is why the
      // pseudonym below is derived from BBL's name for them instead.
      name: 'Jan A',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Jan A' },
        { system: 'tourplay.net', id: 'b21596f2-1177-4712-848c-08db4af58d38' },
        { system: 'NAF', id: '19483' },
      ],
    },
    {
