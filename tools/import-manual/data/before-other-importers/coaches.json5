// Coaches that exist in both BBL and TP source data under different names,
// pre-registered here (before the BBL/TP importers run) so each importer's
// upsert matches this single record instead of creating a duplicate.
//
// BBL only ever surfaces a coach's first name plus, sometimes, a first-initial
// of their last name; TP (tourplay.net/NAF) surfaces their full real name (or,
// for "inforthepain", a username). Pairs below were identified by matching BBL's
// partial name against TP's full name (same first name, and matching last-name
// initial when BBL has one).
//
// The `name` values below are pseudonyms -- first name plus last initial --
// not the coaches' full real names, because this repository is public.
// Matching resolves coaches by `externalIds` and never by `name`, and both the
// BBL and TP importers overwrite this `name` on their own upsert anyway, so
// the pseudonyms have no effect on import correctness.
{
  externalSystems: [
    { name: 'tloeg.bbleague.se', category: 'imported_data_source' },
    { name: 'tourplay.net', category: 'imported_data_source' },
    { name: 'NAF', category: 'referenced_not_imported' },
  ],
  coaches: [
    {
      name: 'Andreas G',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Andreas' },
        { system: 'tourplay.net', id: '17cc91d4-aaf6-45c9-134d-08dacad31bb4' },
        { system: 'NAF', id: '19767' },
      ],
    },
