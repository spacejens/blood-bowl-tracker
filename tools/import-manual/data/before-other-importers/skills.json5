    { skill: { system: 'Name', id: 'Stand Firm' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'strength' },
    { skill: { system: 'Name', id: 'Juggernaut' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'strength' },
    { skill: { system: 'Name', id: 'Strong Arm' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'strength' },
    { skill: { system: 'Name', id: 'Mighty Blow' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'strength' },
    { skill: { system: 'Name', id: 'Thick Skull' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'strength' },

    // --- CRP: Mutation skills (CRP p.21) ---
    { skill: { system: 'Name', id: 'Big Hand' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'mutation' },
    { skill: { system: 'Name', id: 'Foul Appearance' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'mutation' },
