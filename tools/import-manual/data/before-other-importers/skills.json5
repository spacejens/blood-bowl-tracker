    { skill: { system: 'Name', id: 'Claw' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'mutation' },
    { skill: { system: 'Name', id: 'Claws' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'mutation' },
