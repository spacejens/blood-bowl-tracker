    { skill: { system: 'Name', id: 'Accurate' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'passing' },
    { skill: { system: 'Name', id: 'Nerves of Steel' }, rulesSet: { system: 'Name', id: 'CRP' }, category: 'passing' },
