      awardProcedure:
        "Taken from the season's own final standings, as recorded by the source.",
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Major Wooden Spoon' },
        { system: 'tourplay.net', id: 'Wooden Spoon-Major Season' },
