    // matching BBL's own gap, so no stunty/spoon entries are seeded here.
    {
      name: 'Dungeon Bowl Gold',
      recipientKind: 'team',
      competitionGroup: { system: 'Name', id: 'Dungeon Bowl' },
      description: 'Dungeon Bowl winner.',
