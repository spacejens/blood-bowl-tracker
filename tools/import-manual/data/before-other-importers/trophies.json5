      // from the complete 16-entry team legend on `p=tt`.
      //
      // "Korpen" is the old name of this same award, from when the Minor
      // Season was called Korpen; its external id resolves here.
      name: 'Minor Gold',
      recipientKind: 'team',
      competitionGroup: { system: 'Name', id: 'Minor Season' },
      description: 'Minor season winner.',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Minor 1st' },
