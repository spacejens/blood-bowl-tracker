      // or match of its own, so it is curated under "Minor Season" like any
      // other Minor Season trophy.
      name: 'Cabal Vision Cup',
      recipientKind: 'team',
      competitionGroup: { system: 'Name', id: 'Minor Season' },
      description: 'Winner of the Cabal Vision Cup knockout cup.',
      externalIds: [{ system: 'tloeg.bbleague.se', id: 'Cabal Vision Cup' }],
    },
    {
      name: 'Chaos Cup',
      recipientKind: 'team',
      competitionGroup: { system: 'Name', id: 'Chaos Cup' },
      description:
        'The team that wins after four matches selects three players and rolls a D3 to choose one, who is separately awarded the Gudarnas Förkämpe player trophy.',
      externalIds: [
        { system: 'tloeg.bbleague.se', id: 'Chaos Cup' },
        { system: 'tourplay.net', id: '1-Chaos Cup' },
