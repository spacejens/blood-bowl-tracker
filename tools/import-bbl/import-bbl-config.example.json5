// Configuration for tools/import-bbl.
//
// Copy this file to `import-bbl-config.json5` in the same directory and fill in
// real values:
//   cp tools/import-bbl/import-bbl-config.example.json5 tools/import-bbl/import-bbl-config.json5
//
// `import-bbl-config.json5` is git-ignored. See docs/import-bbl/index.md for
// configuration details and how to run the tool.
{
  // Runtime settings for reaching the api-server to import into. This group
  // itself is required.
  connection: {
    // Base URL of the running api-server. Defaults to http://localhost:3000
    // if this field is omitted.
    apiBaseUrl: 'http://localhost:3000',

    // Bearer token this tool authenticates with. Required. Must match the
    // API_TOKEN_IMPORT_BBL value in apps/discord-bot/.env, or the api-server
    // rejects every request with 401. Treat it like a password.
    apiToken: 'your-import-bbl-token-here',
  },

  // Name of the external system BBL records are registered under.
  // Defaults to "BBL" if unset or empty.
  externalSystemName: 'BBL',

  // Path to the folder that directly contains the BBL `default.asp?p=...`
  // files, a subfolder of the git-ignored data/ directory. Kept out of the
  // league group because it describes where the source data lives on disk.
  dataDir: 'data/<subfolder>',

  // An array of the leagues the BBL data covers. Each entry has a leagueName
  // and an eras array of the league's different eras. Rules sets and eras are
  // not present in the mirror, so they are supplied here. dataDir,
  // connection, and externalSystemName stay top-level/shared across all leagues
  // because both leagues read from the same mirror.
  leagues: [
    {
      // Name of the league the BBL data covers. The mirror covers a single league
      // whose name is not in the data. Used as the league's external ID under the
      // BBL and Name external systems.
      leagueName: 'tLoEG',

      // Eras the league played through. Each era is grouped into identity, dates,
      // players, and the optional competitions/teams/matches groups -- see the
      // comments on each field below, at its first appearance in this file.
      eras: [
        {
          // Era name and the rules set(s) it spans -- a non-empty array, in
          // chronological order (most eras list one; an era spanning a
          // rules-set change lists several).
          identity: {
            name: 'First era',
            rulesSets: ['CRP', 'CRP+', 'BB2016'],
          },
          dates: {
            // startDate (required, YYYY-MM-DD) and endDate (optional -- omit for
            // an era still ongoing) bound the era. Always imported into the era's
            // DB record, regardless of autoAssignByDate below.
            startDate: '2011-09-09',
            endDate: '2021-09-01',
            // Required boolean. true: a competition whose earliest match date
            // falls in [startDate, endDate) is automatically assigned to this
            // era. false: this era is never reached by that automatic scan --
            // only through its competitions overrides below (see First Stunty
            // Leeg era for an example).
            autoAssignByDate: true,
          },
          players: {
            // firstPlayerId is required when autoAssignByPlayerId is true
            // (optional otherwise); lastPlayerId is always optional -- when
            // omitted, the range is open-ended above firstPlayerId.
            firstPlayerId: 1,
            lastPlayerId: 4868,
            // Required boolean. true: a player whose pid falls in
            // [firstPlayerId, lastPlayerId] is automatically assigned to this
            // era. false: this era is never reached by that automatic scan --
            // only through teamCodeOverrides/playerIdOverrides.
            autoAssignByPlayerId: true,
            // Explicit pids assigned to this era regardless of the
            // firstPlayerId/lastPlayerId range, checked before it -- BBL player
            // ids are only roughly chronological, so a handful of players
            // drafted right at an era changeover can land on the "wrong" side
            // of a range split; overrides correct those known exceptions
            // without widening the range.
            playerIdOverrides: [4907, 4909, 4911, 4912, 4914, 4915, 4921, 4922, 4923],
          },
          // BBL cannot store a match with more than two teams, so every
          // four-team "Bierhallentodball" match in the Ogretoberfest cups
          // (both the actual final and, in Ogretoberfest 5 and 6, an extra
          // non-final four-team match that used the same format and flavor
          // name) was registered as two two-team rows. Each pair is imported
          // as one match (both external ids, all four teams, the union of
          // both rows' events). Both ids of a pair must be in the same
          // competition's match list. All six of this league's confirmed
          // pairs fall inside First era.
          matches: {
            merges: [
              ['1061', '1062'], // Ogretoberfest 4 final
              ['1311', '1312'], // Ogretoberfest 5 final
              ['1309', '1310'], // Ogretoberfest 5, not the final
              ['1520', '1521'], // Ogretoberfest 6, not the final
              ['1518', '1519'], // Ogretoberfest 6 final
              ['1759', '1760'], // Ogretoberfest 7 final
            ],
            // Optional -- omit entirely (or omit merges above) when an era has
            // no category overrides. Explicit BBL match id -> category
            // assignments for matches the keyword classifier cannot recognize
            // (thematic cup-final names such as "Bierhallentodball") or
            // deliberately refuses to guess at (ambiguous stage-like names).
            // These win over the keyword classifier. A match id may appear in
            // only one entry across all eras.
            //
            // Ogretoberfest 5 and 6 each had two merged four-team
            // "Bierhallentodball" matches, but only one final per
            // competition: the BBL season result page's "Bierhallenförer"
            // player-prize record (default.asp?p=sr&s=<season>) names the
            // trophy-winning Ogre and team for each competition, which
            // identifies which merged pair was the actual final by matching
            // that Ogre's touchdown to one of the two pairs (an Ogre-scored
            // touchdown is the final's win condition; Ogretoberfest 5's other
            // pair was decided by a non-Ogre touchdown instead, which the
            // rules don't credit as a final result). The other pair is left
            // uncategorized here so the classifier's default 'normal'
            // applies, despite it also having four teams.
            categoryOverrides: [
              { matchId: '1061', category: 'cup_final' }, // Ogretoberfest 4
              { matchId: '1062', category: 'cup_final' }, // Ogretoberfest 4
              { matchId: '1311', category: 'cup_final' }, // Ogretoberfest 5 final
              { matchId: '1312', category: 'cup_final' }, // Ogretoberfest 5 final
              { matchId: '1518', category: 'cup_final' }, // Ogretoberfest 6 final
              { matchId: '1519', category: 'cup_final' }, // Ogretoberfest 6 final
              { matchId: '1759', category: 'cup_final' }, // Ogretoberfest 7
              { matchId: '1760', category: 'cup_final' }, // Ogretoberfest 7
            ],
            // Explicit outcomes for matches whose winner cannot be derived from
            // the touchdown count plus the competition's "Team trophy"
            // placements. winnerTeamCode is a BBL team code, or "draw" for a
            // tied match in a stage that normally forbids one.
            resultOverrides: [
              // { matchId: "1061", winnerTeamCode: "sew" },
              // { matchId: "1311", winnerTeamCode: "draw" },
            ],
          },
        },
        {
          identity: {
            name: 'Second era',
            rulesSets: ['BB2020'],
          },
          dates: {
            startDate: '2021-09-01',
            endDate: '2023-06-15',
            autoAssignByDate: true,
          },
          players: {
            firstPlayerId: 4869,
            lastPlayerId: 6098,
            autoAssignByPlayerId: true,
            playerIdOverrides: [
              4484, 4486, 4487, 4491, 4493, 4494, 4602, 4605, 4606, 4611, 4612, 4613,
              4619, 4621, 4623, 4742, 4744, 4745, 4747, 4748, 4751, 4754, 4762, 4768,
              4769, 4781, 4783, 4801, 4802, 4803, 4813, 4817, 4819, 4827, 4828, 4832,
              4833, 4838, 4839, 4842, 4846, 4865,
            ],
          },
          // Optional group -- omit entirely when an era has no overrides.
          // Each entry is a competition bblId hard-assigned to this era and
          // forced to the given type, regardless of match dates -- for a
          // competition with a genuinely empty match list, or whose date
          // span would otherwise misclassify its type. Checked before the
          // match-date scan, so unaffected by autoAssignByDate. A
          // competition bblId may appear in only one override, in only one
          // era, across all eras. startDate/endDate are only consulted when
          // the override competition has no dated matches at all to derive
          // them from -- one that does have matches always uses those
          // instead, and startDate/endDate here are ignored. Competition 74
          // ("Minor Season 25") has no p=ma page in the mirror at all; its
          // startDate/endDate are the half-year following Minor Season 24
          // (the second half of 2023), the only entry in this era that
          // actually needs them.
          competitions: {
            overrides: [
              {
                bblId: '74',
                type: 'season',
                startDate: '2023-07-01',
                endDate: '2023-12-31',
              },
            ],
          },
          // Optional group -- omit entirely when an era has no position
          // overrides (as here). Each entry is keyed by positionId (BBL
          // position typId) and raceId (BBL race bblId); the era itself is
          // implied by which era block the entry is nested under, so there is
          // no eraId field here. Used when the zero-players heuristic (a
          // position with no players recorded in this era is assumed
          // unavailable) mis-decides a position's availability -- e.g. a
          // position that existed in this era's rules set but genuinely went
          // unused, or one that was removed but happens to have leftover
          // player records. Example:
          //   positions: [
          //     { positionId: '12', raceId: '2', available: false },
          //   ],
        },
        {
          identity: {
            name: 'First Stunty Leeg era',
            rulesSets: ['CRP', 'CRP+', 'BB2016'],
          },
          // Real match span 2016-03-12 .. 2016-11-25; endDate is one day past the
          // last match (exclusive-end convention). autoAssignByDate:false keeps
          // this range from capturing unrelated competitions.
          dates: {
            startDate: '2016-03-12',
            endDate: '2016-11-26',
            autoAssignByDate: false,
          },
          // firstPlayerId/lastPlayerId are omitted here -- they serve no
          // purpose when autoAssignByPlayerId is false, since this era is only
          // ever reached through teamCodeOverrides/playerIdOverrides below.
          players: {
            autoAssignByPlayerId: false,
          },
          competitions: {
            overrides: [
              { bblId: '30', type: 'cup' },
              { bblId: '33', type: 'cup' },
            ],
          },
          // Optional group -- omit entirely when an era has no team-code
          // overrides. teamCodeOverrides pins the players of the listed team
          // codes to this era regardless of pid, for a side-competition era
          // (like this one) that shares its concurrent regular era's pid
          // range. Checked before playerIdOverrides and the pid range, so
          // unaffected by autoAssignByPlayerId. A team code may appear in only
          // one era's teamCodeOverrides across all eras. Note: this list and
          // the competitions overrides above are independent and must agree
          // by hand -- teamCodeOverrides should list exactly the team codes
          // that played in the overridden competitions (there is no
          // cross-reference check between the two).
          teams: {
            teamCodeOverrides: ['rad', 'sl-', 'sl-2', 'his', 'oxt', 'ogh'],
          },
          // BBL cannot store a match with more than two teams, so the
          // four-team finals of both Stunty Leeg cups were each registered as
          // two two-team rows -- same pattern as the Ogretoberfest merges
          // above. "SL Final - Deathmatch" (Stunty Leeg 1) and "Deathball"
          // (Stunty Leeg 2) don't parse as finals to the keyword classifier:
          // "Stunty Leeg" is a themed cup competition (like Chaos Cup,
          // Ogretoberfest), and "Deathmatch"/"Deathball" is flavor text with
          // no recognized keyword.
          matches: {
            merges: [
              ['939', '940'],
              ['1073', '1074'],
            ],
            categoryOverrides: [
              { matchId: '939', category: 'cup_final' }, // Stunty Leeg 1, SL Final - Deathmatch
              { matchId: '940', category: 'cup_final' },
              { matchId: '1073', category: 'cup_final' }, // Stunty Leeg 2, Deathball
              { matchId: '1074', category: 'cup_final' },
            ],
            // Stunty Leeg 2's four-team final ended 0-0-0-0 across both
            // source rows -- a genuine draw, developer-confirmed, not a
            // shoot-out or roll-off decided by other means.
            resultOverrides: [{ matchId: '1073', winnerTeamCode: 'draw' }],
          },
        },
        {
          identity: {
            name: 'First Dungeon Bowl era',
            rulesSets: ['DB2021'],
          },
          // Real match span 2022-02-12 .. 2022-08-22; endDate is one day past the
          // last match. autoAssignByDate:false keeps this range from capturing
          // unrelated competitions.
          dates: {
            startDate: '2022-02-12',
            endDate: '2022-08-23',
            autoAssignByDate: false,
          },
          players: {
            autoAssignByPlayerId: false,
          },
          competitions: {
            overrides: [{ bblId: '69', type: 'season' }],
          },
          teams: {
            teamCodeOverrides: ['red4', 'twi', 'dok', 'äng', 'dan', 'lus2'],
          },
        },
      ],
    },
    {
      leagueName: 'GBBL',
      eras: [
        {
          // GBBL 1 is a self-contained 11-team exhibition tournament (BBL season
          // id 55) played Aug-Nov 2019, modeled as its own single-era league. It
          // shares the tLoEG mirror and the BB2016 ruleset that was current then.
          identity: {
            name: 'GBBL 1',
            rulesSets: ['BB2016'],
          },
          // Real match span 2019-08-03 .. 2019-11-12; endDate is one day past the
          // last match (exclusive-end convention). autoAssignByDate:false keeps
          // this range from capturing unrelated competitions.
          dates: {
            startDate: '2019-08-03',
            endDate: '2019-11-13',
            autoAssignByDate: false,
          },
          // Assigned exhaustively via teamCodeOverrides below (an all-star event
          // whose pids overlap tLoEG's ranges), so the pid-range scan is disabled.
          players: {
            autoAssignByPlayerId: false,
          },
          competitions: {
            overrides: [{ bblId: '55', type: 'season' }],
          },
          teams: {
            teamCodeOverrides: [
              'fes2', 'ver', 'liz2', 'hel', 'läd', 'pro2', 'var', 'sma', 'knu', 'wew', 'dum',
            ],
          },
          // This competition's full bracket is Kvalmatch -> Slutspel rond1 (2
          // walkovers) -> Semifinal (2 matches) -> Final + Bronsmatch.
          // "Slutspel rond1 wo" is a preliminary playoff round before the
          // semi-finals -- the same conceptual role as Kvalmatch, both
          // mapping to this enum's single season_qualifier value even though
          // the bracket has two distinct qualifying stages.
          matches: {
            categoryOverrides: [
              { matchId: '1765', category: 'season_qualifier' }, // Slutspel rond1 wo
              { matchId: '1766', category: 'season_qualifier' },
            ],
          },
        },
      ],
    },
  ],
}
