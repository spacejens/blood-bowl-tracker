# Environment configuration for tools/import-bbl.
#
# Copy this file to `.env` in the same directory and fill in real values:
#   cp tools/import-bbl/.env.example tools/import-bbl/.env
#
# `.env` is git-ignored. See docs/import-bbl/index.md for configuration details
# and how to run the tool.

# Base URL of the running api-server to import into.
# Defaults to http://localhost:3000 if unset.
API_BASE_URL=http://localhost:3000

# Path to the folder that directly contains the BBL `default.asp?p=...` files,
# a subfolder of the git-ignored data/ directory.
BBL_DATA_DIR=data/<subfolder>
