# Environment configuration for tools/import-bbl.
#
# Copy this file to `.env` in the same directory and fill in real values:
#   cp tools/import-bbl/.env.example tools/import-bbl/.env
#
# `.env` is git-ignored. See docs/import-bbl/index.md for configuration details
# and how to run the tool.

# Base URL of the running api-server to import into.
# Defaults to http://localhost:3000 if unset.
API_BASE_URL=http://localhost:3000

# Path to the folder that directly contains the BBL `default.asp?p=...` files,
# a subfolder of the git-ignored data/ directory.
BBL_DATA_DIR=data/<subfolder>

# Name of the league the BBL data covers. The mirror covers a single league
# whose name is not in the data, so it is supplied here. Used as the league's
# external ID under the BBL and Name external systems.
BBL_LEAGUE_NAME=<league name>

# Eras the league played through, as a JSON array. Rules sets and eras are not
# present in the mirror, so they are supplied here. Each entry: name, rulesSets
# (non-empty array of rules set names the era spans, in chronological order),
# startDate (required, YYYY-MM-DD), endDate (optional; omit
# for an era still ongoing), firstPlayerId (required), lastPlayerId (optional,
# following the same still-ongoing rule as endDate -- the two must be either
# both omitted or both present; when lastPlayerId is omitted, the era matches
# any pid >= firstPlayerId with no upper bound), and playerIdOverrides
# (optional; explicit pids assigned to this era regardless of the range, for
# players drafted right at the changeover whose pid lands on the "wrong" side
# of a range split), seasonCompetitionIdOverrides and
# cupCompetitionIdOverrides (optional; explicit competition bblIds hard-assigned
# to this era and forced to type season or cup respectively, regardless of match
# dates -- for a competition whose match list is empty, or whose date span would
# otherwise misclassify its type), and teamCodeOverrides (optional; team codes
# whose players are pinned to this era regardless of pid -- for side-competition
# eras that share the concurrent regular era's pid range). A no-competition-id
# appears in more than one of these lists across all eras is rejected.
#
# The "First Stunty Leeg era" and "First Dungeonbowl era" entries below are
# fully override-driven: they have no natural date/pid range, so startDate ==
# endDate (an empty [start, end) range that matches no competition) and
# firstPlayerId == lastPlayerId == 9999999 (outside any real BBL pid) are
# harmless placeholders -- every one of their competitions, teams, races, and
# players is resolved through the override lists instead. Stunty Leeg's matches
# (competitions 30 and 33) fall inside First era, so it copies First era's
# rulesSets; Dungeonbowl is its own rules set (DB2021). The rest is the real
# tLoEG timeline: bounds and overrides derived by matching each player's
# earliest dated match appearance against the 2021-09-01 rules-set changeover
# date (see docs/import-bbl/index.md).
BBL_ERAS=[{"name":"First era","rulesSets":["CRP","CRP+","BB2016"],"startDate":"2011-09-09","endDate":"2021-09-01","firstPlayerId":1,"lastPlayerId":4868,"playerIdOverrides":[4907,4909,4911,4912,4914,4915,4921,4922,4923]},{"name":"Second era","rulesSets":["BB2020"],"startDate":"2021-09-01","endDate":"2023-06-10","firstPlayerId":4869,"lastPlayerId":6098,"playerIdOverrides":[4484,4486,4487,4491,4493,4494,4602,4605,4606,4611,4612,4613,4619,4621,4623,4742,4744,4745,4747,4748,4751,4754,4762,4768,4769,4781,4783,4801,4802,4803,4813,4817,4819,4827,4828,4832,4833,4838,4839,4842,4846,4865],"seasonCompetitionIdOverrides":["74"]},{"name":"First Stunty Leeg era","rulesSets":["CRP","CRP+","BB2016"],"startDate":"9999-01-01","endDate":"9999-01-01","firstPlayerId":9999999,"lastPlayerId":9999999,"cupCompetitionIdOverrides":["30","33"],"teamCodeOverrides":["rad","sl-","sl-2","his","oxt","ogh"]},{"name":"First Dungeonbowl era","rulesSets":["DB2021"],"startDate":"9999-01-01","endDate":"9999-01-01","firstPlayerId":9999999,"lastPlayerId":9999999,"seasonCompetitionIdOverrides":["69"],"teamCodeOverrides":["red4","twi","dok","äng","dan","lus2"]}]

# Pairs of BBL match ids to merge into a single match, as a JSON array of
# two-element string arrays. BBL cannot store a match with more than two teams,
# so the special four-team "Bierhallentodball" finals in the Ogretoberfest cups
# were each registered as two separate two-team match rows. Each configured pair
# is imported as one four-team match: both source matches' external ids, all four
# teams, and every event (correlated across both rows) are folded together. Both
# ids of a pair must be in the same competition's match list, or the pair is left
# unmerged and an error is recorded. Optional -- unset or empty means no merges.
# The value below is this league's six real, confirmed pairs.
BBL_MATCH_MERGES=[["1061","1062"],["1311","1312"],["1309","1310"],["1520","1521"],["1518","1519"],["1759","1760"]]

# Name of the external system BBL records are registered under.
# Defaults to "BBL" if unset or empty.
BBL_EXTERNAL_SYSTEM_NAME=BBL
