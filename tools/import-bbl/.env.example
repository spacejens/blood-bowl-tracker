# Environment configuration for tools/import-bbl.
#
# Copy this file to `.env` in this directory and fill in real values:
#   cp tools/import-bbl/.env.example tools/import-bbl/.env
#
# `.env` is git-ignored. Run this tool from the tools/import-bbl/ directory
# (e.g. `pnpm --filter @blood-bowl-tracker/import-bbl run start -- <file>`)
# so it's picked up automatically, or export API_BASE_URL directly in your
# shell instead.

# Base URL of the running api-server instance to import data into.
# Defaults to http://localhost:3000 (a local docker-compose deployment) if unset.
API_BASE_URL=http://localhost:3000
