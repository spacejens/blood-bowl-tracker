# Environment configuration for tools/import-bbl.
#
# Copy this file to `.env` in this directory and fill in real values:
#   cp tools/import-bbl/.env.example tools/import-bbl/.env
#
# `.env` is git-ignored. Run this tool from the tools/import-bbl/ directory
# (e.g. `pnpm --filter @blood-bowl-tracker/import-bbl run start`) so it's
# picked up automatically, or export the variables directly in your shell.

# Base URL of the running api-server instance to import data into.
# Defaults to http://localhost:3000 (a local docker-compose deployment) if unset.
API_BASE_URL=http://localhost:3000

# Path to the folder that directly contains the BBL `default.asp?p=...` files
# (a wget mirror of the league website). A relative path resolves against the
# current working directory. This folder lives under the git-ignored
# tools/import-bbl/data/ directory; ask the developer for the download if you
# don't have it.
BBL_DATA_DIR=data/tloeg.bbleague.se
