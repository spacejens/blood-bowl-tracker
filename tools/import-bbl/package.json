{
  "name": "@blood-bowl-tracker/import-bbl",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "bin": {
    "import-bbl": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test"
  },
  "dependencies": {
    "@blood-bowl-tracker/api-client": "workspace:*",
    "@blood-bowl-tracker/api-contract": "workspace:*",
    "@blood-bowl-tracker/import": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "cheerio": "^1.2.0",
    "json5": "^2.2.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  }
}
