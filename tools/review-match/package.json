{
  "name": "@blood-bowl-tracker/review-match",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "bin": { "review-match": "dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test"
  },
  "dependencies": {
    "@blood-bowl-tracker/db": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "cheerio": "^1.2.0",
    "drizzle-orm": "rc",
    "json5": "^2.2.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1"
  }
}
