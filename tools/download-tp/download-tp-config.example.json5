// Configuration for tools/download-tp.
//
// Copy this file to `download-tp-config.json5` in the same directory and fill
// in real values:
//   cp tools/download-tp/download-tp-config.example.json5 tools/download-tp/download-tp-config.json5
//
// `download-tp-config.json5` is git-ignored. See docs/download-tp/index.md for
// configuration details and how to run the tool.
{
  // Runtime settings for reaching TP. Both fields are required.
  connection: {
    // Base URL of the TP frontend, including a trailing slash.
    frontendUrl: 'https://<HOSTNAME_AND_FRONTEND_PATH>/blood-bowl/',
    // Base URL of the TP API, including a trailing slash — every API request
    // is sent to a path under it.
    backendApiUrl: 'https://<HOSTNAME_AND_API_PATH>/api/',
  },

  // How to download. `enabled` is required.
  browser: {
    // true to download by driving a real browser (Chrome, through
    // puppeteer); false to fetch TP's API directly over plain HTTP. Required,
    // with no default. Both methods write the same files. The browser method
    // needs Chrome provisioned once — see docs/download-tp/index.md.
    enabled: true,
    // Browser method only: true to run the browser headless (hidden), false
    // to show it; anything other than true shows it. Ignored when enabled is
    // false.
    //
    // Running headless produces console errors from TP's service worker
    // ("A bad HTTP response code (403) was received when fetching the
    // script.", "Service worker registration failed with: JSHandle@error");
    // they do not affect the recorded responses.
    headless: false,
  },

  // What to download. Both keys are required to be present, but either may
  // be set to [] to skip that half entirely — download only tournaments,
  // only the official team list, both, or (both set to []) neither.
  download: {
    // Tournament names to download, as they appear in the frontend path. Set
    // to [] to skip the per-tournament download entirely.
    tournaments: ['<NAME_FROM_FRONTEND_PATH>'],

    // Rules sets to download TP's official per-rules-set team list for. Each
    // value names a tab on https://tourplay.net/en/blood-bowl/teams and the
    // data/teams/<rulesSet>/ output folder. Set to [] to skip the
    // official-teams download entirely. Use the same spelling, exactly
    // (case-sensitively), as import-tp-config.json5's
    // league.eras[].identity.rulesSets, since the server resolves a rules
    // set by its exact external id.
    rulesSets: ['BB2020', 'DB2021', 'BB2025'],
  },
}
