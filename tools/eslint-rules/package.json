{
  "name": "@blood-bowl-tracker/eslint-rules",
  "version": "0.0.1",
  "private": true,
  "main": "dist/max-function-params.js",
  "types": "dist/max-function-params.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  }
}
