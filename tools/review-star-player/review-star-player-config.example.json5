// Configuration for tools/review-star-player.
//
// Copy this file to `review-star-player-config.json5` in the same directory
// and fill in real values:
//   cp tools/review-star-player/review-star-player-config.example.json5 tools/review-star-player/review-star-player-config.json5
//
// `review-star-player-config.json5` is git-ignored. See
// docs/review-star-player/index.md for configuration details and how to run
// the tool.
{
  // The database the imported data was imported into. This tool only reads
  // game data itself, but connects via packages/db's DbModule, which applies
  // any pending migrations on connect (a no-op against a stack deployed from
  // the same branch).
  database: {
    url: 'postgres://blood_bowl:blood_bowl@localhost:5433/blood_bowl',
  },

  // How many star players each stratum picks. Defaults to 3.
  starsPerStratum: 3,

  // Where each source's raw data lives. Relative paths resolve against the
  // current working directory, which is tools/review-star-player/ when the
  // tool is run as documented.
  bbl: {
    // The folder that directly contains the BBL `default.asp?p=...` files.
    dataDir: '../import-bbl/data/tloeg.bbleague.se',
    // Name of the external system BBL records are registered under. Must
    // match import-bbl-config.json5's own externalSystemName.
    externalSystemName: 'tloeg.bbleague.se',
  },
  tp: {
    // The TP data root: it holds a `teams/` folder with one subdirectory per
    // rules set, each holding that rules set's official-team-list response.
    dataDir: '../import-tp/data',
    // Name of the external system TP records are registered under. Must
    // match import-tp-config.json5's own externalSystemName.
    externalSystemName: 'tourplay.net',
  },
  manual: {
    // tools/import-manual's committed data directory: the folder holding the
    // `before-other-importers/` and `after-other-importers/` subfolders. It
    // is tracked by git, so a worktree checkout already has it.
    dataDir: '../import-manual/data',
  },

  // Star players always included in the report regardless of what the strata
  // picked. BBL entries are the numeric typID from
  // `default.asp?p=pt&typID=<id>`; TP entries are TP's own spelling of the
  // star's name; manual entries are the star's stored name.
  overrides: {
    bbl: [],
    tp: [],
    manual: [],
  },

  // Base path each generated report is written next to -- a timestamp is
  // inserted before the extension. Defaults to 'output/report.html'.
  outputPath: 'output/report.html',
}
