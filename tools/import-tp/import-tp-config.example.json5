// Configuration for tools/import-tp.
//
// Copy this file to `import-tp-config.json5` in the same directory and fill
// in real values:
//   cp tools/import-tp/import-tp-config.example.json5 tools/import-tp/import-tp-config.json5
//
// `import-tp-config.json5` is git-ignored. See docs/import-tp/index.md for
// configuration details and how to run the tool.
{
  // Runtime settings for reaching the api-server to import into. This group
  // itself is required, mirroring import-bbl-config.json5's convention.
  connection: {
    // Base URL of the running api-server. Defaults to http://localhost:3000
    // if this field is omitted.
    apiBaseUrl: 'http://localhost:3000',

    // Bearer token this tool authenticates with. Required. Must match the
    // IMPORT_TP_API_TOKEN value in apps/discord-bot/.env, or the api-server
    // rejects every request with 401. Treat it like a password.
    apiToken: 'your-import-tp-token-here',
  },

  // Path to the folder that directly contains one subdirectory per era, a
  // subfolder of the git-ignored data/ directory. A relative path resolves
  // against the current working directory.
  dataDir: 'data',

  // The league being imported: its name and the eras it played through, by
  // their curated names. The league, its eras and their rules sets are not
  // in TP's data (only an opaque numeric rule-set code is), so they are
  // curated in tools/import-manual/data/batches/001-initial-seed.
  league: {
    // Name of the league the TP data covers. It must be a league in batch
    // 001's leagues.json5 (tools/import-manual/data/batches/001-initial-seed),
    // found by its Name id; tLoEG is the only league TP data can use.
    name: 'tLoEG',

    // The eras the data covers, by their curated names (eras.json5 in the
    // same batch holds their dates and rules sets), and which data
    // subdirectory each corresponds to. Subdirectory names are TP's own slugs.
    eras: [
      { identity: { name: 'Third era' }, dataSubdir: 'third-era' },
      { identity: { name: 'Second Dungeon Bowl era' }, dataSubdir: 'second-dungeon-bowl-era' },
      { identity: { name: 'Fourth era' }, dataSubdir: 'fourth-era' },
    ],
  },
}
