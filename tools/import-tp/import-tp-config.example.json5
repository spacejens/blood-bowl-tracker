// Configuration for tools/import-tp.
//
// Copy this file to `import-tp-config.json5` in the same directory and fill
// in real values:
//   cp tools/import-tp/import-tp-config.example.json5 tools/import-tp/import-tp-config.json5
//
// `import-tp-config.json5` is git-ignored. See docs/import-tp/index.md for
// configuration details and how to run the tool.
{
  // Runtime settings for reaching the api-server to import into. This group
  // itself is required, mirroring import-bbl-config.json5's convention.
  connection: {
    // Base URL of the running api-server. Defaults to http://localhost:3000
    // if this field is omitted.
    apiBaseUrl: 'http://localhost:3000',
  },

  // Name of the external system TP records are registered under. Defaults to
  // "TP" if unset or empty.
  externalSystemName: 'TP',

  // Path to the folder that directly contains one subdirectory per era, a
  // subfolder of the git-ignored data/ directory. A relative path resolves
  // against the current working directory.
  dataDir: 'data',

  // Everything that describes the league being imported: its name and the
  // eras it played through. Rule sets and eras are not present in TP's data
  // (only an opaque numeric rule-set code is), so they are supplied here,
  // same as import-bbl-config.json5.
  league: {
    // Name of the league the TP data covers. Used as the league's external
    // ID under the TP and Name external systems.
    name: 'tLoEGBBL',

    // Eras the league played through, and which data subdirectory each
    // corresponds to. Subdirectory names are TP's own slugs and don't
    // necessarily match the era's display name in the database.
    eras: [
      {
        // Era name and the rule set(s) it spans -- a non-empty array, in
        // chronological order.
        identity: {
          name: 'Third era',
          rulesSets: ['LRB6'],
        },
        // startDate (required, YYYY-MM-DD) and endDate (optional -- omit for
        // an era still ongoing).
        dates: {
          startDate: '2013-01-01',
          endDate: '2016-12-31',
        },
        dataSubdir: 'third-era',
      },
      {
        identity: {
          name: 'Second Dungeon Bowl era',
          rulesSets: ['Dungeon Bowl 2021'],
        },
        dates: {
          startDate: '2021-01-01',
          endDate: '2021-12-31',
        },
        dataSubdir: 'second-dungeon-bowl-era',
      },
      {
        identity: {
          name: 'Fourth era',
          rulesSets: ['BB2020'],
        },
        dates: {
          startDate: '2020-11-28',
        },
        dataSubdir: 'fourth-era',
      },
    ],
  },
}
