// Configuration for tools/import-tp.
//
// Copy this file to `import-tp-config.json5` in the same directory and fill
// in real values:
//   cp tools/import-tp/import-tp-config.example.json5 tools/import-tp/import-tp-config.json5
//
// `import-tp-config.json5` is git-ignored. See docs/import-tp/index.md for
// configuration details and how to run the tool.
{
  // Runtime settings for reaching the api-server to import into. This group
  // itself is required, mirroring import-bbl-config.json5's convention.
  connection: {
    // Base URL of the running api-server. Defaults to http://localhost:3000
    // if this field is omitted.
    apiBaseUrl: 'http://localhost:3000',
  },

  // Path to the folder that directly contains one subdirectory per era, a
  // subfolder of the git-ignored data/ directory. A relative path resolves
  // against the current working directory.
  dataDir: 'data',

  // Eras to import from, and which data subdirectory each corresponds to.
  // Subdirectory names are TP's own slugs and don't necessarily match the
  // era's display name in the database.
  eras: [
    { name: 'Third era', dataSubdir: 'third-era' },
    { name: 'Second Dungeon Bowl era', dataSubdir: 'second-dungeon-bowl-era' },
    { name: 'Fourth era', dataSubdir: 'fourth-era' },
  ],
}
