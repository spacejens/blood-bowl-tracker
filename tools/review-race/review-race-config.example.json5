// Configuration for tools/review-race.
//
// Copy this file to `review-race-config.json5` in the same directory and fill
// in real values:
//   cp tools/review-race/review-race-config.example.json5 tools/review-race/review-race-config.json5
//
// `review-race-config.json5` is git-ignored. See docs/review-race/index.md
// for configuration details and how to run the tool.
{
  // The database the imported data was imported into. This tool only reads
  // game data itself, but connects via packages/db's DbModule, which applies
  // any pending migrations on connect (a no-op against a stack deployed from
  // the same branch).
  database: {
    url: 'postgres://blood_bowl:blood_bowl@localhost:5433/blood_bowl',
  },

  // How many races each stratum picks. Defaults to 3.
  racesPerStratum: 3,

  // Where each source's raw data lives. Relative paths resolve against the
  // current working directory, which is tools/review-race/ when the tool is
  // run as documented.
  bbl: {
    // The folder that directly contains the BBL `default.asp?p=...` files.
    dataDir: '../import-bbl/data/tloeg.bbleague.se',
    // Name of the external system BBL records are registered under. Must
    // match import-bbl-config.json5's own externalSystemName -- defaults to
    // "BBL" if unset or empty, but the importer registers "tloeg.bbleague.se"
    // by convention in this project, so that is the value to use here.
    externalSystemName: 'tloeg.bbleague.se',
  },
  tp: {
    // The folder that directly contains one subdirectory per era; each era
    // directory holds one subdirectory per competition, holding the
    // `rosters_<id>.json` files.
    dataDir: '../import-tp/data',
    // Name of the external system TP records are registered under. Must
    // match import-tp-config.json5's own externalSystemName -- defaults to
    // "TP" if unset or empty, but the importer registers "tourplay.net" by
    // convention in this project, so that is the value to use here.
    externalSystemName: 'tourplay.net',
  },
  manual: {
    // tools/import-manual's committed data directory: the folder holding the
    // `before-other-importers/` and `after-other-importers/` subfolders. It
    // is tracked by git, so a worktree checkout already has it -- no data
    // symlink is needed for this source.
    dataDir: '../import-manual/data',
    // The hand-curated data registers into the BBL/TP/Name external id spaces
    // rather than one of its own, so no externalSystemName applies here.
  },

  // Races always included in the report regardless of what the strata picked.
  // BBL and TP entries are each source's own external race id (BBL: the
  // numeric race id from `default.asp?p=tl#<id>`; TP: the `teamRace` code,
  // e.g. 'Dwarf_BB2025'). Manual entries are the race's own name, since the
  // hand-curated data has no external-id space of its own.
  overrides: {
    bbl: [],
    tp: [],
    manual: [],
  },

  // Base path each generated report is written next to -- a timestamp is
  // inserted before the extension. Defaults to 'output/report.html'.
  outputPath: 'output/report.html',
}
