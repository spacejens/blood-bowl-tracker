{
  "name": "blood-bowl-tracker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "test": "pnpm -r run test",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm format && pnpm test",
    "db:diagram": "tools/db-diagram/db-diagram.sh",
    "hygiene:audit": "pnpm audit",
    "hygiene:audit:fix": "pnpm audit --fix=update",
    "hygiene:deadcode": "knip",
    "hygiene:deadcode:fix": "knip --fix",
    "hygiene:deadcode:production": "knip --production",
    "hygiene:versions": "syncpack lint",
    "hygiene:versions:fix": "syncpack fix",
    "hygiene:cycles": "madge --circular --extensions ts --exclude '(^|/)(node_modules|dist)/' apps packages tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "knip": "6.32.2",
    "madge": "8.0.0",
    "prettier": "^3.9.6",
    "syncpack": "15.3.3",
    "typescript-eslint": "^8.66.0"
  }
}
