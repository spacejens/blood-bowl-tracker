{
  "name": "blood-bowl-tracker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "test": "pnpm -r run test",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "hygiene:deps": "ncu -u --workspaces",
    "hygiene:deps:list": "ncu --workspaces --format group",
    "hygiene:audit": "pnpm audit",
    "hygiene:audit:fix": "pnpm audit --fix=update",
    "hygiene:deadcode": "knip",
    "hygiene:deadcode:fix": "knip --fix",
    "hygiene:deadcode:production": "knip --production",
    "hygiene:versions": "syncpack lint",
    "hygiene:versions:fix": "syncpack fix",
    "hygiene:cycles": "madge --circular --extensions ts --exclude '(^|/)(node_modules|dist)/' apps packages tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "knip": "6.24.0",
    "madge": "8.0.0",
    "npm-check-updates": "22.2.9",
    "prettier": "^3.9.4",
    "syncpack": "15.3.2",
    "typescript-eslint": "^8.63.0"
  }
}
