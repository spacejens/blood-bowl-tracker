{
  // Full config reference: https://knip.dev/reference/configuration
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Report unused exports from package entry files (src/index.ts barrels)
  // too; by default Knip treats everything an entry file exports as public
  // API. Types used by an exported signature in the same file stay exported.
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  // markdownlint-cli2 loads this rule by file path from .markdownlint-cli2.jsonc,
  // which Knip cannot follow, so its default export is public API.
  "ignoreIssues": {
    "tools/markdownlint-rules/src/index.ts": ["exports"]
  },
  "workspaces": {
    "apps/*": {},
    "packages/*": {},
    "tools/*": {},
    // db-generate.ts is a CLI entrypoint invoked only via the db:generate
    // npm script (node dist/scripts/db-generate.js), not imported by other
    // source, so Knip's default entry patterns don't pick it up on their
    // own. Declaring it as an entry (rather than ignoring the file outright)
    // keeps its own imports — e.g. @nestjs/core — visible to Knip's
    // dependency-usage analysis.
    "packages/db": {
      "entry": ["src/scripts/db-generate.ts"]
    }
  }
  // Add "ignore" (file globs) or "ignoreDependencies" (package names) here
  // to silence false positives, e.g.:
  // "ignoreDependencies": ["some-package-only-used-via-a-cli-script"]
}
