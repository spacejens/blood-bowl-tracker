# Environment configuration for apps/discord-bot.
#
# Copy this file to `.env` in the same directory and fill in real values:
#   cp apps/discord-bot/.env.example apps/discord-bot/.env
#
# `.env` is git-ignored and is loaded by docker-compose at runtime.
# See docs/discord-bot/index.md for step-by-step setup instructions.
#
# This file also documents the shape of `apps/discord-bot/.env.production`,
# the git-ignored file holding the *production* values pushed to Fly.io with
# `fly secrets import < apps/discord-bot/.env.production`. There is
# deliberately no separate `.env.production.example`: a second template would
# drift out of sync with this one.
#
# `.env.production` uses the same variables listed below, but its values are
# an independent set, not a copy of your local ones — the Discord token and
# channel ids point at the real production Discord application and server, the
# API tokens are separate production secrets, and the RANDOM_INSIGHTS_* values
# may be tuned differently than in local development. It must also set
# DATABASE_URL (see below), which local development instead gets from
# docker-compose.yml. See docs/discord-bot/production-hosting.md.

# PostgreSQL connection string. Local development does NOT set this here —
# docker-compose.yml supplies it for the `discord-bot` service, so leave it
# out of your local `.env`. It is required in `.env.production`, where it is
# the Neon **direct** (non-pooled) connection string for the
# `blood-bowl-tracker` project in region eu-central-1. Use the direct string,
# not Neon's pooled/PgBouncer variant: the bot is a single long-lived
# container with its own connection pool, not a burst of short-lived
# serverless invocations, so pooling adds nothing here.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Bot token from the Discord Developer Portal:
#   Applications > (your application) > Bot > Reset Token.
# Treat this like a password — anyone with the token can control your bot.
DISCORD_BOT_TOKEN=your-bot-token-here

# ID of the channel the bot posts its startup message to: a deployment
# status message, posted on every startup.
# Enable Developer Mode (User Settings > Advanced > Developer Mode),
# then right-click the target channel > Copy Channel ID.
STARTUP_MESSAGE_DISCORD_CHANNEL=000000000000000000

# Whether the standby machine also announces itself on startup. Optional:
# omitted, or set to any value other than `false`, means enabled — which is
# the behaviour when this variable does not exist at all. Set it to `false`
# to silence the standby's boot message, useful in local development where
# frequent restarts make it noise. Only the *standby* announcement is
# affected; the active machine always posts its startup message.
# STANDBY_STARTUP_MESSAGE_ENABLED=false

# Scheduled random insights.
# A standard 5-field cron expression (an optional sixth leading field is
# seconds), evaluated in the bot process's local time zone (in the Docker
# deployment this is UTC unless TZ is set). An invalid expression makes the
# bot fail to start. The example posts hourly, on the hour, which suits local
# testing where fast feedback matters; a live deployment posting to real
# server members typically wants a far lower frequency, such as once a day
# (0 8 * * *).
RANDOM_INSIGHTS_CRON=0 * * * *
# ID of the channel the scheduled random insights are posted to. Once the bot
# is released to real server members this is typically a separate, dedicated
# channel for the bot's automated output rather than the startup message
# channel; sharing one channel is fine for purely local testing.
RANDOM_INSIGHTS_DISCORD_CHANNEL=000000000000000000
# Percent chance (integer 0-100) that a scheduled insight is scoped to one
# randomly chosen era or competition rather than unfiltered.
RANDOM_INSIGHTS_FILTER_PROBABILITY=50
# Percent chance (integer 0-100) that an era- or competition-scoped insight
# draws only from ongoing eras (eras with no end date) rather than all eras.
RANDOM_INSIGHTS_FILTER_CURRENT_ERA_PROBABILITY=75

# Bearer tokens the API accepts on /rpc, one per importer tool. Each importer
# sends its own token as `Authorization: Bearer <token>`; a request with no
# token, or with a token that matches none of these, is rejected with 401.
# Pick any hard-to-guess string per tool for local development, and keep each
# value in sync with the matching `connection.apiToken` in that tool's
# `import-*-config.json5`. Treat these like passwords.
# A variable left empty disables that caller entirely.
API_TOKEN_IMPORT_BBL=your-import-bbl-token-here
API_TOKEN_IMPORT_TP=your-import-tp-token-here
API_TOKEN_IMPORT_MANUAL=your-import-manual-token-here
