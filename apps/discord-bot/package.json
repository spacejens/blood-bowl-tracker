    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "cron": "^4.4.0",
    "discord.js": "^14.27.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
