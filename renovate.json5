{
  // Full config reference: https://docs.renovatebot.com/configuration-options/
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // Matches pnpm-workspace.yaml's minimumReleaseAge: 1440 (24h) local-install
  // gate, so Renovate never proposes an update pnpm would then refuse to
  // install locally. Exception: a vulnerability-driven update bypasses this
  // gate entirely (see the vulnerabilityAlerts note on the major-update rule
  // below), so it can land before pnpm's own gate would allow installing it
  // locally or in CI's lockfile update — if that happens, add the package to
  // pnpm-workspace.yaml's minimumReleaseAgeExclude, the same way existing
  // entries there already handle this.
  minimumReleaseAge: '1 day',
  // GitHub's native vulnerability alerts (Dependabot alerts) are enabled on
  // this repo (detection only — Dependabot's own automated-security-fixes PR
  // creation stays off, so Renovate remains the only tool opening PRs here),
  // which is what Renovate's vulnerabilityAlerts handling reads from to
  // detect that an update resolves a known vulnerability. Without this,
  // every update (including a security fix) would be treated as an ordinary
  // one and subject to the major-update minimumReleaseAge rule below.
  packageRules: [
    {
      // Coordinated release train: these packages must share a version
      // within a workspace, so an update to one without the others would
      // leave incompatible versions installed together.
      groupName: '@nestjs packages',
      matchPackageNames: ['@nestjs/*'],
    },
    {
      // Coordinated release train: @vitest/coverage-v8 must match vitest's
      // own version.
      groupName: 'vitest',
      matchPackageNames: ['vitest', '@vitest/coverage-v8'],
    },
    {
      // Node stays fully owned by code-hygiene's Node version task: it keeps
      // .nvmrc, every Dockerfile FROM node:... line, and every workspace's
      // @types/node in lock-step, and understands LTS semantics for the
      // -alpine tag suffix this repo uses (Renovate's node versioning does
      // not — see https://github.com/renovatebot/renovate/issues/13270).
      // Renovate must not also propose updates for these or the two systems
      // could conflict. No matchManagers filter here on purpose — it must
      // cover every manager that could touch node/@types/node (npm,
      // dockerfile, docker-compose, nvm for .nvmrc, and any future one).
      matchPackageNames: ['node', '@types/node'],
      enabled: false,
    },
    {
      // Automerge: no branch protection exists on `main` in this repo
      // (confirmed via `gh api repos/.../branches/main/protection` -> 404
      // "Branch not protected"), so Renovate's own automerge can merge
      // directly via the API once CI passes — no bot-approval workaround
      // needed. Scoped to patch and minor, without a confidence gate:
      // matchConfidence-driven automerge ("Smart Merge Control") requires a
      // paid Mend Repository Integration and is not available on the free
      // Renovate GitHub App this repo uses — see
      // https://docs.mend.io/wsk/renovate-github-app ("Smart Merge Control
      // is not a feature offered on this edition of Renovate"). Minor is in
      // scope on the evidence of this repo's own history instead: across
      // dozens of patch and minor dependency updates made by hand before
      // Renovate was introduced, exactly one needed a code change, and that
      // change fixed a newly-surfaced lint error — which CI catches, and a
      // red CI run blocks automerge anyway. Major updates did need real
      // code changes when tested the same way, so they are deliberately not
      // listed here and keep waiting for a human.
      // Deliberately no groupName here: this rule only sets automerge, so it
      // never overrides another rule's groupName (the @nestjs/vitest groups
      // above keep their names, and every other dependency keeps its own
      // one-PR-per-dependency default) — a groupName here would bundle every
      // patch and minor update into one shared automerging PR, an
      // all-or-nothing failure mode where one broken dependency blocks
      // automerge for every other one in the same PR.
      // Scoped to the npm manager only: CI (.github/workflows/ci.yml) runs
      // pnpm build/lint/typecheck/test, which validates an npm dependency
      // patch or minor bump, but never builds or deploys the Docker image —
      // Docker tag updates (docker-compose's postgres/schemaspy) have no
      // PR-time validation at all, so they must never automerge
      // unvalidated. This also excludes the github-actions manager
      // (actions/checkout, actions/setup-node, flyctl); those are pinned to
      // floating major/minor tags (@v4, @1.5) so patch and minor updates
      // essentially never fire for them anyway.
      matchManagers: ['npm'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
    },
    {
      // Majors get a longer soak than the repo-wide 1-day gate. A brand-new
      // major version typically lands before its peer and downstream
      // packages have caught up, so a PR opened the moment it publishes
      // tends to be broken or stuck — it then sits around, or has to go
      // through `finish-renovate-pr`, until the ecosystem settles. Seven
      // days lets that settling happen before Renovate proposes the bump at
      // all. Patch and minor updates are unaffected and keep the repo-wide
      // 1-day default.
      // Scoped to the npm manager on purpose: Docker image and GitHub
      // Actions majors have a different risk profile and none of npm's
      // peer-dependency churn, so they also keep the 1-day default.
      // No vulnerability carve-out is needed here: Renovate's own built-in
      // default for `vulnerabilityAlerts` sets `minimumReleaseAge: null`,
      // which bypasses the gate — repo-wide or per-rule — for
      // vulnerability-driven updates, detected via the repo's native GitHub
      // vulnerability alerts (see the note above `packageRules`). A major
      // that resolves a known security advisory is therefore not delayed by
      // this rule, and no explicit exception belongs in this file.
      matchManagers: ['npm'],
      matchUpdateTypes: ['major'],
      minimumReleaseAge: '7 days',
    },
    {
      // Triage aid: label every Renovate PR with the kind of bump it
      // contains, so the list can be scanned at a glance and each update
      // given scrutiny proportional to its risk. The `renovate:` prefix
      // namespaces these apart from this repo's hand-maintained labels
      // (bug, development, feature, ...) and keeps them sorted together in
      // GitHub's label list. Not pre-created: Renovate creates each label
      // via the GitHub API the first time it applies it, in default gray.
      // `addLabels`, not `labels`: Renovate merges `addLabels` across every
      // matching packageRule by appending, whereas `labels` replaces the
      // whole list. For npm patch and minor PRs, this overlaps with the
      // automerge rule above (which is npm-only, unlike this rule); either
      // way, `addLabels` is what guarantees the update-type label is added
      // without clobbering, or being clobbered by, labels set elsewhere.
      // One rule covers all six types because `{{updateType}}` is
      // Renovate's own per-PR template interpolation, resolving to whichever
      // type applies. lockFileMaintenance and replacement are deliberately
      // absent — not part of the triage use case; they can be added here
      // later the same way.
      matchUpdateTypes: ['patch', 'minor', 'major', 'pin', 'digest', 'rollback'],
      addLabels: ['renovate:{{updateType}}'],
    },
    // No catch-all group: every dependency not matched above gets its own PR
    // by Renovate's default, so one broken update never blocks the rest.
    // (config:recommended does still apply Renovate's own small, curated
    // group presets — e.g. well-known monorepo-published package families —
    // but those only bundle genuinely coordinated releases, the same idea as
    // the explicit groups above, not a broad catch-all.) Add more
    // packageRules entries here for other coordinated release trains that
    // need to move together, or to exclude specific dependencies, e.g.:
    // {
    //   groupName: 'eslint',
    //   matchPackageNames: ['eslint', 'eslint-*', '@eslint/*', 'typescript-eslint'],
    // },
  ],
}
