{
  "name": "@blood-bowl-tracker/import-tp-live",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test"
  },
  "dependencies": {
    "@blood-bowl-tracker/api-contract": "workspace:*",
    "@blood-bowl-tracker/domain-enums": "workspace:*",
    "@blood-bowl-tracker/game-data": "workspace:*",
    "@blood-bowl-tracker/parse-tp": "workspace:*",
    "@blood-bowl-tracker/scrape-tp": "workspace:*",
    "@blood-bowl-tracker/tp-paths": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@blood-bowl-tracker/db": "workspace:*",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.0",
    "unplugin-swc": "^1.5.10",
    "vite": "^8.2.1",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
  }
}
